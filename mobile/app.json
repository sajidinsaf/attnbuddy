{
  "expo": {
    "name": "Brasstacks",
    "slug": "brasstacks",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "brasstacks",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.visibleai.brasstacks"
    },
    "android": {
      "package": "com.visibleai.brasstacks",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ]
  }
}
